  "contract": {
    "delivery_semantics": "at-least-once",
    "exactly_once_claim": false,
    "at_most_once_claim": false,
    "event_and_delivery_id_stability": "preallocated UUIDv7 values never change across attempts or generations",
    "logical_uniqueness_fields": ["workspace_id", "effect_digest", "event_type", "event_version", "destination_configuration_digest"],
    "transaction_position_uniqueness_fields": ["workspace_id", "workspace_transaction_sequence", "ordinal"],
    "claim_isolation": "READ COMMITTED",
    "claim_locking": "FOR UPDATE SKIP LOCKED",
    "selection_rule": "lowest nonterminal stream sequence whose predecessors are delivered or abandoned",
    "live_leases_per_stream": 1,
    "lease_seconds": 60,
    "lease_clock": "PostgreSQL clock_timestamp()",
    "attempt_deadline_seconds": 30,
    "lease_renewal_allowed": false,
    "claim_or_crash_consumes_attempt": true,
    "ack_compare_and_swap_fields": ["delivery_id", "lease_token", "generation"],
    "backoff": "uniform random in upper half of min(5 * 2^(attempt - 1), 3600) seconds",
    "dead_letter_attempts_per_generation": 12,
    "dead_letter_generation_age_seconds": 604800,
    "permanent_failure_dead_letters_immediately": true,
    "poison_blocks_stream": true,
    "management_authority": "authenticated Human only",
    "replay_identity_rule": "new generation and bounded retry window; same event, delivery, payload, and stream sequence",
    "abandonment_rule": "advance management cursor only; preserve immutable event and delivery history",
    "receipt_claim": "adapter observation only, never proof of remote side effect",
    "next_attempt_storage": "database timestamp",
    "history_facts_append_only": ["attempt", "receipt", "management"]
  },
