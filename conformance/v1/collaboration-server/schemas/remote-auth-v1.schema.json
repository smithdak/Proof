{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proof.dev/schema/collaboration-server/remote-auth/v1",
  "title": "Proof collaboration-server remote authentication contracts",
  "oneOf": [
    { "$ref": "#/$defs/oidcIssuerConfigurationV1" },
    { "$ref": "#/$defs/oidcAuthenticatedSubjectV1" },
    { "$ref": "#/$defs/oidcSubjectCommitmentInputV1" },
    { "$ref": "#/$defs/oidcSubjectCommitmentOpeningV1" },
    { "$ref": "#/$defs/oidcPrincipalBindingV1" },
    { "$ref": "#/$defs/oidcPrincipalBindingPrivateV1" },
    { "$ref": "#/$defs/oidcPrincipalBindingRevocationV1" },
    { "$ref": "#/$defs/remoteAuthenticationEventV1" },
    { "$ref": "#/$defs/authenticatedActorContextV2" },
    { "$ref": "#/$defs/authenticatedActorContextEvidenceV2" }
  ],
  "$defs": {
    "uuidv7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^blake3:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
    },
    "httpsIssuer": {
      "type": "string",
      "format": "uri",
      "minLength": 9,
      "maxLength": 2048,
      "pattern": "^https://[^?#]+$"
    },
    "audience": {
      "type": "string",
      "pattern": "^proof://workspace/[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "authorityHead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_digest", "sequence"],
      "properties": {
        "record_digest": { "$ref": "#/$defs/digest" },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "authoritySequence": {
      "type": "integer",
      "minimum": 2,
      "maximum": 9007199254740991
    },
    "authorityKeyId": {
      "type": "string",
      "pattern": "^ed25519:[0-9a-f]{64}$"
    },
    "nullableUuidv7": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/uuidv7" }
      ]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$"
        },
        "version": {
          "type": "string",
          "minLength": 16,
          "maxLength": 256,
          "pattern": "^proof\\.dev/operation/[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+/v[1-9][0-9]*$"
        }
      }
    },
    "agentSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api_version", "provider", "subject"],
      "properties": {
        "api_version": { "const": "proof.dev/authenticated-subject/v1" },
        "provider": { "const": "proof/local-ed25519" },
        "subject": {
          "type": "string",
          "pattern": "^ed25519:[0-9a-f]{64}$"
        }
      }
    },
    "oidcIssuerConfigurationV1": {
      "title": "OidcIssuerConfigurationV1",
      "description": "Public, secret-free deployment configuration. Its digest is RFC 8785 canonical JSON under proof:oidc-issuer-configuration:v1.",
      "x-proof-digest-context": "proof:oidc-issuer-configuration:v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_id_token_algorithms",
        "api_version",
        "authorization_code_flow",
        "client_id",
        "clock_skew_seconds",
        "configuration_source",
        "configuration_id",
        "discovery_uri",
        "discovery_metadata_digest",
        "endpoint_egress_policy",
        "authorization_endpoint",
        "issuer",
        "jwks_uri",
        "pkce_method",
        "redirect_uri",
        "response_issuer_parameter_required",
        "session_absolute_seconds",
        "session_cookie_name",
        "session_idle_seconds",
        "token_endpoint",
        "token_endpoint_auth_method",
        "client_credential_reference",
        "tokens_retained"
      ],
      "properties": {
        "api_version": { "const": "proof.dev/oidc-issuer-configuration/v1" },
        "configuration_id": { "$ref": "#/$defs/uuidv7" },
        "configuration_source": { "const": "trusted-deployment-configuration" },
        "issuer": { "$ref": "#/$defs/httpsIssuer" },
        "discovery_uri": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "pattern": "^https://[^?#]+$"
        },
        "authorization_endpoint": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "pattern": "^https://[^?#]+$"
        },
        "token_endpoint": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "pattern": "^https://[^?#]+$"
        },
        "jwks_uri": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "pattern": "^https://[^?#]+$"
        },
        "client_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "redirect_uri": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "pattern": "^https://[^?#]+/auth/oidc/callback$"
        },
        "discovery_metadata_digest": {
          "description": "Digest of the exact accepted RFC 8785 discovery metadata under proof:oidc-discovery-metadata:v1.",
          "x-proof-digest-context": "proof:oidc-discovery-metadata:v1",
          "$ref": "#/$defs/digest"
        },
        "endpoint_egress_policy": { "const": "deployment-allowlist-no-redirect" },
        "accepted_id_token_algorithms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["EdDSA", "ES256", "PS256", "RS256"] }
        },
        "authorization_code_flow": { "const": true },
        "pkce_method": { "const": "S256" },
        "response_issuer_parameter_required": { "const": true },
        "token_endpoint_auth_method": { "const": "client_secret_basic" },
        "client_credential_reference": {
          "type": "string",
          "pattern": "^deployment-secret:[a-z][a-z0-9._-]{2,127}$"
        },
        "tokens_retained": { "const": false },
        "clock_skew_seconds": { "const": 30 },
        "session_cookie_name": { "const": "__Host-Http-Proof-Session" },
        "session_idle_seconds": { "const": 900 },
        "session_absolute_seconds": { "const": 28800 }
      }
    },
    "oidcAuthenticatedSubjectV1": {
      "title": "OidcAuthenticatedSubjectV1",
      "type": "object",
      "additionalProperties": false,
      "required": ["api_version", "issuer", "provider", "subject"],
      "properties": {
        "api_version": { "const": "proof.dev/oidc-authenticated-subject/v1" },
        "provider": { "const": "proof/oidc" },
        "issuer": { "$ref": "#/$defs/httpsIssuer" },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        }
      }
    },
    "oidcSubjectCommitmentInputV1": {
      "title": "OidcSubjectCommitmentInputV1",
      "description": "Private preimage for proof:oidc-authenticated-subject-commitment:v1. The blind is base64url without padding for exactly 32 random bytes.",
      "x-proof-digest-context": "proof:oidc-authenticated-subject-commitment:v1",
      "type": "object",
      "additionalProperties": false,
      "required": ["api_version", "blind", "subject", "workspace_id"],
      "properties": {
        "api_version": { "const": "proof.dev/oidc-subject-commitment-input/v1" },
        "workspace_id": { "$ref": "#/$defs/uuidv7" },
        "subject": { "$ref": "#/$defs/oidcAuthenticatedSubjectV1" },
        "blind": {
          "type": "string",
          "minLength": 43,
          "maxLength": 43,
          "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
        }
      }
    },
    "oidcSubjectCommitmentOpeningV1": {
      "title": "OidcSubjectCommitmentOpeningV1",
      "description": "Protected audit disclosure; it is excluded from public actor evidence and ordinary exports.",
      "type": "object",
      "additionalProperties": false,
      "required": ["api_version", "commitment", "input"],
      "properties": {
        "api_version": { "const": "proof.dev/oidc-subject-commitment-opening/v1" },
        "commitment": { "$ref": "#/$defs/digest" },
        "input": { "$ref": "#/$defs/oidcSubjectCommitmentInputV1" }
      }
    },
    "oidcPrincipalBindingV1": {
      "title": "OidcPrincipalBindingV1",
      "description": "Public decoded authority payload. Raw issuer/subject and the blind exist only in the protected binding lookup/opening; this signed fact carries their hiding commitment.",
      "x-proof-protected-resolution": "OidcPrincipalBindingPrivateV1 must match workspace_id, binding_id, principal_id, issuer configuration, and subject commitment before authentication.",
      "x-proof-lifecycle-rules": [
        "one exact case-sensitive (issuer, subject) resolves to at most one Principal for the Workspace lifetime",
        "a superseding binding names an existing binding for the same Principal and exact protected subject",
        "a revoked or retired protected subject cannot be rebound or reassigned"
      ],
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "authority_key_id",
        "authority_sequence",
        "binding_id",
        "evaluated_authority_head",
        "issued_at",
        "issued_by_principal_id",
        "oidc_issuer_configuration_digest",
        "principal_id",
        "previous_authority_record_digest",
        "subject_commitment",
        "supersedes_binding_id",
        "workspace_id"
      ],
      "properties": {
        "api_version": { "const": "proof.dev/oidc-principal-binding/v1" },
        "workspace_id": { "$ref": "#/$defs/uuidv7" },
        "binding_id": { "$ref": "#/$defs/uuidv7" },
        "principal_id": { "$ref": "#/$defs/uuidv7" },
        "subject_commitment": { "$ref": "#/$defs/digest" },
        "oidc_issuer_configuration_digest": { "$ref": "#/$defs/digest" },
        "issued_by_principal_id": { "$ref": "#/$defs/uuidv7" },
        "issued_at": { "$ref": "#/$defs/timestamp" },
        "supersedes_binding_id": { "$ref": "#/$defs/nullableUuidv7" },
        "evaluated_authority_head": { "$ref": "#/$defs/authorityHead" },
        "authority_sequence": { "$ref": "#/$defs/authoritySequence" },
        "previous_authority_record_digest": { "$ref": "#/$defs/digest" },
        "authority_key_id": { "$ref": "#/$defs/authorityKeyId" }
      }
    },
    "oidcPrincipalBindingPrivateV1": {
      "title": "OidcPrincipalBindingPrivateV1",
      "description": "Protected adapter lookup and commitment opening. It is forbidden from ordinary logs, Problems, ContextPacks, and portable public evidence.",
      "x-proof-semantic-equalities": [
        "workspace_id == opening.input.workspace_id",
        "subject == opening.input.subject",
        "subject_commitment == opening.commitment",
        "binding_record_digest resolves to an OidcPrincipalBindingV1 with the same workspace_id, binding_id, principal_id, oidc_issuer_configuration_digest, and subject_commitment"
      ],
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "binding_id",
        "binding_record_digest",
        "oidc_issuer_configuration_digest",
        "opening",
        "principal_id",
        "subject",
        "subject_commitment",
        "workspace_id"
      ],
      "properties": {
        "api_version": { "const": "proof.dev/oidc-principal-binding-private/v1" },
        "workspace_id": { "$ref": "#/$defs/uuidv7" },
        "binding_id": { "$ref": "#/$defs/uuidv7" },
        "principal_id": { "$ref": "#/$defs/uuidv7" },
        "subject": { "$ref": "#/$defs/oidcAuthenticatedSubjectV1" },
        "subject_commitment": { "$ref": "#/$defs/digest" },
        "opening": { "$ref": "#/$defs/oidcSubjectCommitmentOpeningV1" },
        "oidc_issuer_configuration_digest": { "$ref": "#/$defs/digest" },
        "binding_record_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "oidcPrincipalBindingRevocationV1": {
      "title": "OidcPrincipalBindingRevocationV1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "authority_key_id",
        "authority_sequence",
        "binding_id",
        "binding_record_digest",
        "evaluated_authority_head",
        "principal_id",
        "previous_authority_record_digest",
        "reason",
        "revocation_id",
        "revoked_at",
        "revoked_by_actor_context_digest",
        "revoked_by_principal_id",
        "subject_commitment",
        "workspace_id"
      ],
      "properties": {
        "api_version": { "const": "proof.dev/oidc-principal-binding-revocation/v1" },
        "workspace_id": { "$ref": "#/$defs/uuidv7" },
        "revocation_id": { "$ref": "#/$defs/uuidv7" },
        "binding_id": { "$ref": "#/$defs/uuidv7" },
        "binding_record_digest": { "$ref": "#/$defs/digest" },
        "principal_id": { "$ref": "#/$defs/uuidv7" },
        "subject_commitment": { "$ref": "#/$defs/digest" },
        "revoked_by_principal_id": { "$ref": "#/$defs/uuidv7" },
        "revoked_by_actor_context_digest": { "$ref": "#/$defs/digest" },
        "revoked_at": { "$ref": "#/$defs/timestamp" },
        "reason": {
          "enum": ["administrative", "compromise", "disablement", "recovery"]
        },
        "evaluated_authority_head": { "$ref": "#/$defs/authorityHead" },
        "authority_sequence": { "$ref": "#/$defs/authoritySequence" },
        "previous_authority_record_digest": { "$ref": "#/$defs/digest" },
        "authority_key_id": { "$ref": "#/$defs/authorityKeyId" }
      }
    },
    "remoteAuthenticationEventV1": {
      "title": "RemoteAuthenticationEventV1",
      "description": "Secret-free server authentication event. Its digest is RFC 8785 canonical JSON under proof:remote-authentication-event:v1.",
      "x-proof-digest-context": "proof:remote-authentication-event:v1",
      "x-proof-lifetime-rule": "authenticated_at is strictly before expires_at. For a selected authorization attempt, AuthenticatedActorContextEvidenceV2.authenticated_at equals this authenticated_at byte-for-byte, authenticated_at is no later than RemoteAuthorizationDecisionV1.evaluated_at, and that decision time is strictly before expires_at. Equality at expiry is invalid.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "authenticated_at",
        "authentication_event_id",
        "authentication_method",
        "expires_at",
        "oidc_issuer_configuration_digest",
        "requesting_binding_id",
        "requesting_binding_record_digest",
        "requesting_principal_id",
        "requesting_subject_commitment",
        "workspace_id"
      ],
      "properties": {
        "api_version": { "const": "proof.dev/remote-authentication-event/v1" },
        "workspace_id": { "$ref": "#/$defs/uuidv7" },
        "authentication_event_id": { "$ref": "#/$defs/uuidv7" },
        "authentication_method": { "const": "oidc-authorization-code-pkce-s256" },
        "oidc_issuer_configuration_digest": { "$ref": "#/$defs/digest" },
        "requesting_subject_commitment": { "$ref": "#/$defs/digest" },
        "requesting_binding_id": { "$ref": "#/$defs/uuidv7" },
        "requesting_binding_record_digest": { "$ref": "#/$defs/digest" },
        "requesting_principal_id": { "$ref": "#/$defs/uuidv7" },
        "authenticated_at": { "$ref": "#/$defs/timestamp" },
        "expires_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "humanContext": {
      "title": "AuthenticatedActorContextV2 oidc_human",
      "x-proof-normalized-input-digest-rule": "normalized_input_digest is BLAKE3-256 derive-key proof:remote-normalized-operation-input:v1 over RFC 8785 of {api_version:proof.dev/remote-normalized-operation-input/v1,input:<the exact strict normalized operation input>,operation:<the exact operation>}. This protected value is not copied to public evidence.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "audience",
        "authenticated_at",
        "authentication_profile",
        "evaluated_authority_head",
        "oidc_issuer_configuration_digest",
        "normalized_input_digest",
        "operation",
        "requesting_binding_id",
        "requesting_binding_record_digest",
        "requesting_principal_id",
        "requesting_subject",
        "requesting_subject_commitment",
        "authentication_event_id",
        "authentication_event_digest",
        "workspace_id"
      ],
      "properties": {
        "api_version": { "const": "proof.dev/authenticated-actor-context/v2" },
        "audience": { "$ref": "#/$defs/audience" },
        "workspace_id": { "$ref": "#/$defs/uuidv7" },
        "authentication_profile": { "const": "proof.server/authentication/oidc-human/v1" },
        "oidc_issuer_configuration_digest": { "$ref": "#/$defs/digest" },
        "normalized_input_digest": {
          "description": "Private runtime digest of the exact normalized operation input. It is available only inside the protected adapter/application transaction and is never copied into public actor evidence or a signed exported authorization decision.",
          "$ref": "#/$defs/digest"
        },
        "requesting_subject": { "$ref": "#/$defs/oidcAuthenticatedSubjectV1" },
        "requesting_subject_commitment": { "$ref": "#/$defs/digest" },
        "requesting_binding_id": { "$ref": "#/$defs/uuidv7" },
        "requesting_binding_record_digest": { "$ref": "#/$defs/digest" },
        "requesting_principal_id": { "$ref": "#/$defs/uuidv7" },
        "authentication_event_id": { "$ref": "#/$defs/uuidv7" },
        "authentication_event_digest": { "$ref": "#/$defs/digest" },
        "operation": { "$ref": "#/$defs/operation" },
        "authenticated_at": { "$ref": "#/$defs/timestamp" },
        "evaluated_authority_head": { "$ref": "#/$defs/authorityHead" }
      }
    },
    "humanAgentContext": {
      "title": "AuthenticatedActorContextV2 oidc_human_agent",
      "x-proof-normalized-input-digest-rule": "normalized_input_digest is BLAKE3-256 derive-key proof:remote-normalized-operation-input:v1 over RFC 8785 of {api_version:proof.dev/remote-normalized-operation-input/v1,input:<the exact strict signed normalized_input>,operation:<the exact signed operation>}. It is distinct from the public projection digest even when the projection discloses that entire input.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "audience",
        "authenticated_at",
        "authentication_profile",
        "command_digest",
        "command_envelope_digest",
        "delegation_id",
        "evaluated_authority_head",
        "oidc_issuer_configuration_digest",
        "normalized_input_digest",
        "operating_binding",
        "operating_principal_id",
        "operating_subject",
        "operation",
        "presentation_id",
        "requesting_binding_id",
        "requesting_binding_record_digest",
        "requesting_principal_id",
        "requesting_subject",
        "requesting_subject_commitment",
        "authentication_event_id",
        "authentication_event_digest",
        "workspace_id"
      ],
      "properties": {
        "api_version": { "const": "proof.dev/authenticated-actor-context/v2" },
        "audience": { "$ref": "#/$defs/audience" },
        "workspace_id": { "$ref": "#/$defs/uuidv7" },
        "authentication_profile": { "const": "proof.server/authentication/oidc-human-agent/v1" },
        "oidc_issuer_configuration_digest": { "$ref": "#/$defs/digest" },
        "normalized_input_digest": {
          "description": "Private runtime digest of the exact signed normalized input. It is never substituted for the separately defined public-safe input projection digest.",
          "$ref": "#/$defs/digest"
        },
        "requesting_subject": { "$ref": "#/$defs/oidcAuthenticatedSubjectV1" },
        "requesting_subject_commitment": { "$ref": "#/$defs/digest" },
        "requesting_binding_id": { "$ref": "#/$defs/uuidv7" },
        "requesting_binding_record_digest": { "$ref": "#/$defs/digest" },
        "requesting_principal_id": { "$ref": "#/$defs/uuidv7" },
        "authentication_event_id": { "$ref": "#/$defs/uuidv7" },
        "authentication_event_digest": { "$ref": "#/$defs/digest" },
        "operating_subject": { "$ref": "#/$defs/agentSubject" },
        "operating_binding": {
          "description": "Exact historical PrincipalBindingV1 authority-record reference whose key verifies operating_subject and the signed command. Current time/revocation and Delegation evaluation deliberately occur only in authorization, permitting consumed signed denials for a binding that is now inactive.",
          "type": "object",
          "additionalProperties": false,
          "required": ["authority_sequence", "binding_id", "record_digest"],
          "properties": {
            "authority_sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "binding_id": { "$ref": "#/$defs/uuidv7" },
            "record_digest": { "$ref": "#/$defs/digest" }
          }
        },
        "operating_principal_id": { "$ref": "#/$defs/uuidv7" },
        "delegation_id": { "$ref": "#/$defs/uuidv7" },
        "operation": { "$ref": "#/$defs/operation" },
        "command_digest": { "$ref": "#/$defs/digest" },
        "command_envelope_digest": { "$ref": "#/$defs/digest" },
        "presentation_id": { "$ref": "#/$defs/uuidv7" },
        "authenticated_at": { "$ref": "#/$defs/timestamp" },
        "evaluated_authority_head": { "$ref": "#/$defs/authorityHead" }
      }
    },
    "authenticatedActorContextV2": {
      "title": "AuthenticatedActorContextV2",
      "oneOf": [
        { "$ref": "#/$defs/humanContext" },
        { "$ref": "#/$defs/humanAgentContext" }
      ]
    },
    "humanContextEvidence": {
      "description": "Public redaction of the Human actor context. Its digest is RFC 8785 canonical JSON under proof:authenticated-actor-context-evidence:v2.",
      "x-proof-digest-context": "proof:authenticated-actor-context-evidence:v2",
      "x-proof-public-input-projection-rule": "public_input_projection_digest is BLAKE3-256 derive-key proof:public-operation-input-projection:v1 over RFC 8785 of {\"api_version\":\"proof.dev/public-operation-input-projection/v1\",\"input\":<the exact operation-specific public projection>,\"operation\":<exact operation>}. The operation input Schema defines that projection. Protected raw issuer/subject, commitment blind, token, code, session, and private exact-input digest are forbidden. For oidc-binding.issue/v1 the projection uses binding/principal/config/supersession/idempotency identifiers and the retry-stabilized blinded subject_commitment; it never includes or hashes raw issuer or subject.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "audience",
        "authenticated_at",
        "authentication_profile",
        "evaluated_authority_head",
        "oidc_issuer_configuration_digest",
        "public_input_projection_digest",
        "operation",
        "requesting_binding_id",
        "requesting_binding_record_digest",
        "requesting_principal_id",
        "requesting_subject_commitment",
        "authentication_event_id",
        "authentication_event_digest",
        "workspace_id"
      ],
      "properties": {
        "api_version": { "const": "proof.dev/authenticated-actor-context-evidence/v2" },
        "audience": { "$ref": "#/$defs/audience" },
        "workspace_id": { "$ref": "#/$defs/uuidv7" },
