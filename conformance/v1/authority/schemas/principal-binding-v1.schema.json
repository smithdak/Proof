{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proof.dev/schema/authority/principal-binding/v1",
  "title": "PrincipalBindingV1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "proof.dev/principal-binding/v1"
    },
    "authority_sequence": {
      "$ref": "#/$defs/sequence"
    },
    "previous_authority_record_digest": {
      "$ref": "#/$defs/nullable_digest"
    },
    "workspace_id": {
      "$ref": "#/$defs/uuidv7"
    },
    "binding_id": {
      "$ref": "#/$defs/uuidv7"
    },
    "principal_id": {
      "$ref": "#/$defs/uuidv7"
    },
    "principal_type": {
      "const": "agent"
    },
    "authenticated_subject": {
      "allOf": [
        {
          "$ref": "https://proof.dev/schema/authority/authenticated-subject/v1"
        },
        {
          "properties": {
            "provider": {
              "const": "proof/local-ed25519"
            }
          }
        }
      ]
    },
    "algorithm": {
      "const": "ed25519"
    },
    "public_key": {
      "$ref": "#/$defs/ed25519_public_key"
    },
    "key_usage": {
      "const": "authenticated-command"
    },
    "audience": {
      "$ref": "#/$defs/audience"
    },
    "enrollment_challenge_digest": {
      "$ref": "#/$defs/digest"
    },
    "enrollment_envelope_digest": {
      "$ref": "#/$defs/digest"
    },
    "issued_by_principal_id": {
      "$ref": "#/$defs/uuidv7"
    },
    "issued_at": {
      "$ref": "#/$defs/timestamp"
    },
    "not_before": {
      "$ref": "#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "#/$defs/timestamp"
    },
    "supersedes_binding_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/uuidv7"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "api_version",
    "authority_sequence",
    "previous_authority_record_digest",
    "workspace_id",
    "binding_id",
    "principal_id",
    "principal_type",
    "authenticated_subject",
    "algorithm",
    "public_key",
    "key_usage",
    "audience",
    "enrollment_challenge_digest",
    "enrollment_envelope_digest",
    "issued_by_principal_id",
    "issued_at",
    "not_before",
    "expires_at",
    "supersedes_binding_id"
  ],
  "$defs": {
    "uuidv7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^blake3:[0-9a-f]{64}$"
    },
    "nullable_digest": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "audience": {
      "type": "string",
      "pattern": "^proof://workspace/[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "ed25519_public_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
    }
  }
}
