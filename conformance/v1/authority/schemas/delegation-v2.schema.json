{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proof.dev/schema/authority/delegation/v2",
  "title": "DelegationV2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "proof.dev/delegation/v2"
    },
    "authority_sequence": {
      "$ref": "#/$defs/sequence"
    },
    "previous_authority_record_digest": {
      "$ref": "#/$defs/nullable_digest"
    },
    "delegation_id": {
      "$ref": "#/$defs/uuidv7"
    },
    "workspace_id": {
      "$ref": "#/$defs/uuidv7"
    },
    "delegation_profile": {
      "const": "proof.local/authority/direct/v1"
    },
    "issuer_principal_id": {
      "$ref": "#/$defs/uuidv7"
    },
    "recipient_principal_id": {
      "$ref": "#/$defs/uuidv7"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "enum": [
          "changeset:add",
          "changeset:commit",
          "changeset:create",
          "changeset:diff",
          "changeset:get",
          "changeset:submit",
          "changeset:validate",
          "context:build",
          "edition:create",
          "object:query_released",
          "release:create",
          "workspace:status"
        ]
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "environment_ids": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,127}$"
          }
        },
        "object_ids": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/uuidv7"
          }
        },
        "schema_ids": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,127}$"
          }
        },
        "locales": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2,8}(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?(?:-(?:[A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))*$",
            "maxLength": 64
          }
        }
      },
      "required": [
        "environment_ids",
        "object_ids",
        "schema_ids",
        "locales"
      ]
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_objects": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_context_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "max_edits_per_changeset": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "allow_subdelegation": {
          "const": false
        }
      },
      "required": [
        "max_objects",
        "max_context_bytes",
        "max_edits_per_changeset",
        "allow_subdelegation"
      ]
    },
    "not_before": {
      "$ref": "#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "#/$defs/timestamp"
    },
    "issued_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "required": [
    "api_version",
    "authority_sequence",
    "previous_authority_record_digest",
    "delegation_id",
    "workspace_id",
    "delegation_profile",
    "issuer_principal_id",
    "recipient_principal_id",
    "actions",
    "scope",
    "constraints",
    "not_before",
    "expires_at",
    "issued_at"
  ],
  "$defs": {
    "uuidv7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^blake3:[0-9a-f]{64}$"
    },
    "nullable_digest": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
    }
  }
}
