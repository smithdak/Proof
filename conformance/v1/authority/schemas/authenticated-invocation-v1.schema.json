{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proof.dev/schema/authority/authenticated-invocation/v1",
  "title": "AuthenticatedInvocationV1",
  "x-proof-max-canonical-bytes": 1048576,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "api_version": { "const": "proof.dev/authenticated-invocation/v1" },
    "command_input": { "$ref": "https://proof.dev/schema/authority/command-input/v1" },
    "authentication": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    }
  },
  "required": ["api_version", "command_input", "authentication"]
}
