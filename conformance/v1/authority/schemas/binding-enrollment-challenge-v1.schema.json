{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proof.dev/schema/authority/binding-enrollment-challenge/v1",
  "title": "BindingEnrollmentChallengeV1",
  "x-proof-max-canonical-bytes": 4096,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "proof.dev/binding-enrollment-challenge/v1"
    },
    "challenge_id": {
      "$ref": "#/$defs/uuidv7"
    },
    "audience": {
      "$ref": "#/$defs/audience"
    },
    "workspace_id": {
      "$ref": "#/$defs/uuidv7"
    },
    "binding_id": {
      "$ref": "#/$defs/uuidv7"
    },
    "principal_id": {
      "$ref": "#/$defs/uuidv7"
    },
    "candidate_key_id": {
      "$ref": "#/$defs/ed25519_key_id"
    },
    "issued_by_principal_id": {
      "$ref": "#/$defs/uuidv7"
    },
    "issued_at": {
      "$ref": "#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "required": [
    "api_version",
    "challenge_id",
    "audience",
    "workspace_id",
    "binding_id",
    "principal_id",
    "candidate_key_id",
    "issued_by_principal_id",
    "issued_at",
    "expires_at"
  ],
  "$defs": {
    "uuidv7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "audience": {
      "type": "string",
      "pattern": "^proof://workspace/[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "ed25519_key_id": {
      "type": "string",
      "pattern": "^ed25519:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
    }
  }
}
