{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proof.dev/schema/authority/delegation-revocation/v1",
  "title": "DelegationRevocationV1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "proof.dev/delegation-revocation/v1"
    },
    "authority_sequence": {
      "$ref": "#/$defs/sequence"
    },
    "previous_authority_record_digest": {
      "$ref": "#/$defs/digest"
    },
    "workspace_id": {
      "$ref": "#/$defs/uuidv7"
    },
    "revocation_id": {
      "$ref": "#/$defs/uuidv7"
    },
    "delegation_id": {
      "$ref": "#/$defs/uuidv7"
    },
    "revoked_by_principal_id": {
      "$ref": "#/$defs/uuidv7"
    },
    "revoked_at": {
      "$ref": "#/$defs/timestamp"
    },
    "reason": {
      "enum": [
        "administrative",
        "compromise",
        "issuer_request",
        "scope_change"
      ]
    }
  },
  "required": [
    "api_version",
    "authority_sequence",
    "previous_authority_record_digest",
    "workspace_id",
    "revocation_id",
    "delegation_id",
    "revoked_by_principal_id",
    "revoked_at",
    "reason"
  ],
  "$defs": {
    "uuidv7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^blake3:[0-9a-f]{64}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
    }
  }
}
