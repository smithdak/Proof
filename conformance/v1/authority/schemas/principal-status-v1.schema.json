{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proof.dev/schema/authority/principal-status/v1",
  "title": "PrincipalStatusV1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "proof.dev/principal-status/v1"
    },
    "authority_sequence": {
      "$ref": "#/$defs/sequence"
    },
    "previous_authority_record_digest": {
      "$ref": "#/$defs/nullable_digest"
    },
    "workspace_id": {
      "$ref": "#/$defs/uuidv7"
    },
    "principal_id": {
      "$ref": "#/$defs/uuidv7"
    },
    "principal_type": {
      "enum": [
        "agent",
        "human"
      ]
    },
    "enabled": {
      "type": "boolean"
    },
    "recorded_by_principal_id": {
      "$ref": "#/$defs/uuidv7"
    },
    "recorded_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "required": [
    "api_version",
    "authority_sequence",
    "previous_authority_record_digest",
    "workspace_id",
    "principal_id",
    "principal_type",
    "enabled",
    "recorded_by_principal_id",
    "recorded_at"
  ],
  "$defs": {
    "uuidv7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^blake3:[0-9a-f]{64}$"
    },
    "nullable_digest": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
    }
  }
}
