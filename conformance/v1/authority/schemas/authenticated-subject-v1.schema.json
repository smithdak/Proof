{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proof.dev/schema/authority/authenticated-subject/v1",
  "title": "AuthenticatedSubjectV1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "proof.dev/authenticated-subject/v1"
    },
    "provider": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    }
  },
  "required": [
    "api_version",
    "provider",
    "subject"
  ],
  "oneOf": [
    {
      "properties": {
        "provider": {
          "const": "os/unix"
        },
        "subject": {
          "type": "string",
          "pattern": "^uid:(?:0|[1-9][0-9]{0,19})$"
        }
      }
    },
    {
      "properties": {
        "provider": {
          "const": "proof/local-ed25519"
        },
        "subject": {
          "type": "string",
          "pattern": "^ed25519:[0-9a-f]{64}$"
        }
      }
    }
  ]
}
