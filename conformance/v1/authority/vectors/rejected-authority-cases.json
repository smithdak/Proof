{
  "api_version": "proof.dev/conformance/authority-rejected-cases/v1",
  "status": "proposed",
  "baseline_fixtures": [
    "workspace-authority-root-transition.payload.valid.json",
    "workspace-authority-root-transition.envelope.valid.json",
    "binding-enrollment-challenge.envelope.valid.json",
    "principal-binding.authority-envelope.valid.json"
  ],
  "cases": [
    {
      "id": "root-transition-missing-signature",
      "layer": "authority",
      "condition": "root_transition_missing_signature",
      "target_fixture": "workspace-authority-root-transition.envelope.valid.json",
      "mutation": {
        "kind": "json_remove",
        "path": "/signatures/1",
        "value": null
      },
      "public_code": "proof.auth.malformed",
      "audit_reason": "proof.authority.integrity",
      "expected_authorized": false,
      "expected_decision_append": false
    },
    {
      "id": "root-transition-duplicate-keyid",
      "layer": "authority",
      "condition": "root_transition_duplicate_keyid",
      "target_fixture": "workspace-authority-root-transition.envelope.valid.json",
      "mutation": {
        "kind": "json_replace",
        "path": "/signatures/1/keyid",
        "value": "ed25519:247b9ffc395d19a551889705a93c7cb466a4b5aea9e315f974b7b46dbe7f9453"
      },
      "public_code": "proof.auth.malformed",
      "audit_reason": "proof.authority.integrity",
      "expected_authorized": false,
      "expected_decision_append": false
    },
    {
